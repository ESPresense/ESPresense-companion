# Copy to testnet/.env. Use a live broker account that can only read espresense/#.
LIVE_HOST=
LIVE_PORT=1883
LIVE_TLS=false
LIVE_USERNAME=
LIVE_PASSWORD=

# Your Companion config.yaml. Only read; its mqtt section is replaced before Companion sees it.
HOUSE_CONFIG=

# Limits for the Companion under test. Lower them to match a smaller host.
COMPANION_CPUS=4
COMPANION_MEMORY=2g

# UI_PORT=0 picks a free port; up.sh prints it.
UI_BIND=127.0.0.1
UI_PORT=0

# true writes every live message to the data volume (raw house ids, ~200 MB a day). Don't commit these.
RECORD_TRAFFIC=false

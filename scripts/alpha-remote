#!/bin/sh
# Runs ON the Home Assistant host (fed over ssh by scripts/alpha and .crow/alpha.yaml).
#
#   sh -s -- <image tag>   run that image in place of the add-on's own (pr-<number>-<sha7>)
#   sh -s -- off           put the released image back
#   sh -s -- status        show which commit is running
#
# The Supervisor starts the add-on from the local image tagged with the add-on's version, so
# tagging another image as that version and restarting the add-on is the whole trick. The
# released image is kept as alpha-backup-<version>.
set -eu

arg=${1:?usage: alpha-remote <image tag>|off|status}
image=espresense/espresense-companion

container=$(docker ps --format '{{.Names}}' | grep -E "^(app|addon)_.*espresense-companion${ALPHA_ADDON:+.*$ALPHA_ADDON}" | head -n1)
[ -n "$container" ] || { echo "No running ESPresense Companion add-on" >&2; exit 1; }
slug=${container#*_}
version=$(docker inspect "$container" --format '{{.Config.Image}}')
version=${version##*:}

restart() {
  ha apps restart "$slug" 2>&1 | grep -v 'is deprecated' || true
  sleep 5
}

status() {
  docker inspect "$container" --format "$slug ($version) runs commit {{index .Config.Labels \"org.opencontainers.image.revision\"}}"
  docker images --format '{{.Repository}}:{{.Tag}} {{.ID}}' | grep "^$image:" || true
}

case "$arg" in
  status)
    status
    ;;
  off)
    if docker image inspect "$image:alpha-backup-$version" >/dev/null 2>&1; then
      docker tag "$image:alpha-backup-$version" "$image:$version"
      docker image remove "$image:alpha-backup-$version" >/dev/null
    else
      docker pull -q "$image:$version"
    fi
    restart
    status
    ;;
  *)
    printf '%s' "$arg" | grep -Eqx 'pr-[0-9]+-[0-9a-f]{7}' || { echo "Not a PR image tag: $arg" >&2; exit 1; }
    docker pull -q "$image:$arg"
    docker image inspect "$image:alpha-backup-$version" >/dev/null 2>&1 || docker tag "$image:$version" "$image:alpha-backup-$version"
    docker tag "$image:$arg" "$image:$version"
    restart
    status
    ;;
esac

#!/bin/sh
# Forced command for the CI alpha key on the Home Assistant host: the only thing that key can do
# is swap the Companion add-on's image (see scripts/alpha-remote, installed next to this file).
#
# Install both on the host, then authorise the key with:
#   command="/path/to/alpha-forced-command",restrict ssh-ed25519 AAAA... crow-companion-alpha
set -eu

arg=${SSH_ORIGINAL_COMMAND:-status}
printf '%s' "$arg" | grep -Eqx 'pr-[0-9]+-[0-9a-f]{7}|off|status' || { echo "Refusing: $arg" >&2; exit 1; }
exec sh "$(dirname "$0")/alpha-remote" "$arg"
